# Coolify instance the launcher reads from.
COOLIFY_URL=https://coolify.edgestudios.co.za

# Required. Coolify UI -> Profile -> API Tokens. Read-only scope is enough.
COOLIFY_TOKEN=

# How often the server re-polls Coolify, in milliseconds. The browser polls
# the server every 30s independently of this.
REFRESH_MS=60000

# Heading shown at the top of the page.
TITLE=EdgeStudios

# Optional: comma-separated resource names to leave off the page.
HIDE=

# --- Access control -------------------------------------------------------
# Pocket-ID SSO. Set all three and the launcher requires a Pocket-ID login.
# Create the client in Pocket-ID with callback URL:
#   https://launch.edgestudios.co.za/auth/callback
OIDC_ISSUER=https://id.edgestudios.co.za
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
BASE_URL=https://launch.edgestudios.co.za

# Optional: restrict to members of these Pocket-ID groups (comma-separated).
# Empty means any user Pocket-ID authenticates.
OIDC_ALLOWED_GROUPS=

# Fallback only, used when the OIDC values above are unset. With neither set,
# the page is open to anyone who can reach the hostname.
PASSCODE=
